                                                Spacing="6">
                                                <TextBlock
                                                    Text="Zdobyte:"
                                                    FontSize="10"
                                                    Opacity="0.55"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding ObserverBlackAdvantageText}"
                                                    FontFamily="Segoe UI Symbol"
                                                    Foreground="{StaticResource ChessPrimaryTextBrush}"
                                                    FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right">
                                            <TextBlock
                                                Text="Wynik"
                                                FontSize="11"
                                                Opacity="0.55"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Text="{Binding ObserverResult}"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="Kontrola czasu"
                                            FontSize="11"
                                            Opacity="0.55" />
                                        <TextBlock
                                            Text="{Binding ObserverFormatText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1">
                                        <TextBlock
                                            Text="Czas"
                                            FontSize="11"
                                            Opacity="0.55" />
                                        <TextBlock
                                            Text="{Binding ObserverDurationText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Content="{Binding ObserverPrimaryButtonText}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ToggleObservedMatch_Click"
                                    IsEnabled="{Binding CanControlObserverMatch}"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Grid.Column="1"
                                    Content="Zakończ partię"
                                    Click="StopObservedMatch_Click"
                                    IsEnabled="{Binding CanControlObserverMatch}"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource ChessDangerButtonStyle}" />
                            </Grid>
                            <Border
                                Grid.Row="2"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource ChessBorderBrush}"
                                Padding="0,12,0,0">
                                <TextBlock
                                    Text="Ruchy"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </Border>
                            <ListView
                                Grid.Row="3"
                                ItemsSource="{Binding ObserverMoveLog}"
                                SelectionChanged="ObserverMoveLog_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:MoveLogEntryViewModel">
                                        <Grid
                                            Padding="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="45" />
                                                <ColumnDefinition
                                                    Width="*" />
                                                <ColumnDefinition
                                                    Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Number}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind WhiteMove}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind BlackMove}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid
                                Grid.Row="4"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content=""
                                    FontFamily="Segoe Fluent Icons"
                                    Click="ObserverPrevious_Click"
                                    IsEnabled="{Binding CanBrowsePreviousObserverPosition}">
                                    <Button.Resources>
                                        <SolidColorBrush
                                            x:Key="ButtonBackgroundPointerOver"
                                            Color="Transparent" />
                                        <SolidColorBrush
                                            x:Key="ButtonBackgroundPressed"
                                            Color="Transparent" />
                                        <SolidColorBrush
                                            x:Key="ButtonForegroundPointerOver"
                                            Color="{StaticResource ChessIconPointerOverColor}" />
                                    </Button.Resources>
                                </Button>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding ObserverPositionText}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content=""
                                    FontFamily="Segoe Fluent Icons"
                                    Click="ObserverNext_Click"
                                    IsEnabled="{Binding CanBrowseNextObserverPosition}">
                                    <Button.Resources>
                                        <SolidColorBrush
                                            x:Key="ButtonBackgroundPointerOver"
                                            Color="Transparent" />
                                        <SolidColorBrush
                                            x:Key="ButtonBackgroundPressed"
                                            Color="Transparent" />
                                        <SolidColorBrush
                                            x:Key="ButtonForegroundPointerOver"
                                            Color="{StaticResource ChessIconPointerOverColor}" />
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <!-- Ustawienia aplikacji -->
            <Grid
                x:Name="SettingsView"
                Visibility="Collapsed"
                Padding="24"
                RowSpacing="18"
                DataContext="{x:Bind Hub}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        Text="Ustawienia"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Język i informacje o aplikacji"
                        Opacity="0.65" />
                </StackPanel>
                <Border
                    Grid.Row="1"
                    Width="520"
                    HorizontalAlignment="Left"
                    Background="{StaticResource ChessPanelBrush}"
                    BorderBrush="{StaticResource ChessBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    RequestedTheme="Dark">
                    <StackPanel
                        Spacing="18">
                        <ComboBox
                            Header="Język aplikacji"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                        <Grid>
                            <StackPanel>
                                <TextBlock
                                    Text="Wersja API"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Środowisko uruchomieniowe"
                                    FontSize="12"
                                    Opacity="0.6" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding ApiVersion}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Zapisane partie -->
            <Grid
                x:Name="SavedGamesView"
                Visibility="Collapsed"
                Padding="24"
                RowSpacing="16"
                DataContext="{x:Bind Hub}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        Text="Zapisane partie silników"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="PGN i analiza zapisane lokalnie"
                        Opacity="0.65" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="420" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView
                        ItemsSource="{Binding SavedGames}"
                        SelectedItem="{Binding SelectedSavedGame, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate
                                x:DataType="models:SavedEngineGame" xmlns:models="using:ChessDesktopApp.Models">
                                <Border
                                    Padding="8,5">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Usuń zapisaną partię"
                                                Tag="{x:Bind}"
                                                Click="DeleteSavedGameFromMenu_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon
                                                        Glyph="" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{x:Bind PairingText}"
                                            FontWeight="SemiBold" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                Text="{x:Bind Result}" />
                                            <TextBlock
                                                Text="{x:Bind ResultReason}"
                                                Opacity="0.65" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind DateText}"
                                            FontSize="12"
                                            Opacity="0.55" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border
                        Grid.Column="1"
                        Background="{StaticResource ChessPanelBrush}"
                        BorderBrush="{StaticResource ChessBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        RequestedTheme="Dark">
                        <Grid
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="Auto" />
                                <RowDefinition
                                    Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding SelectedGameSummary}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Content="Usuń"
                                        Click="DeleteSelectedSavedGame_Click"
                                        IsEnabled="{Binding HasSelectedSavedGame}"
                                        Style="{StaticResource ChessDangerButtonStyle}" />
                                    <Button
                                        Content="Otwórz na planszy"
                                        Click="OpenSavedGameOnBoard_Click"
                                        IsEnabled="{Binding HasSelectedSavedGame}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border
                                Grid.Row="1"
                                Background="{StaticResource ChessPanelInsetBrush}"
                                BorderBrush="{StaticResource ChessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock
                                        Text="{Binding SelectedGamePgn}"
                                        TextWrapping="Wrap"
                                        FontFamily="Cascadia Mono"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <!-- Historia i statystyki turniejów -->
            <Grid
                x:Name="TournamentHistoryView"
                Visibility="Collapsed"
                Padding="24"
                RowSpacing="16"
                DataContext="{x:Bind Hub}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock
                            Text="Historia turniejów"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Lokalnie zapisane turnieje — wybierz, aby otworzyć pełne dane"
                            Opacity="0.65" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            Content="Nowy turniej"
                            Click="NewTournament_Click"
                            IsEnabled="{Binding CanCreateNewTournament}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
                <TextBox
                    Grid.Row="1"
                    PlaceholderText="Szukaj po nazwie turnieju lub silnika"
                    Text="{Binding TournamentSearchText, Mode=TwoWay}"
                    MinWidth="300"
                    MaxWidth="560"
                    HorizontalAlignment="Left" />
                <ListView
                    Grid.Row="2"
                    ItemsSource="{Binding TournamentHistory}"
                    SelectedItem="{Binding SelectedTournament, Mode=TwoWay}"
                    IsItemClickEnabled="True"
                    ItemClick="TournamentHistory_ItemClick"
                    ItemContainerStyle="{StaticResource TournamentCardListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate
                            x:DataType="models:EngineTournament" xmlns:models="using:ChessDesktopApp.Models">
                            <Grid
                                ColumnSpacing="18">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="Usuń turniej"
                                            Tag="{x:Bind}"
                                            Click="DeleteTournamentFromMenu_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    Glyph="" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="2*" />
                                    <ColumnDefinition
                                        Width="2*" />
                                    <ColumnDefinition
                                        Width="2*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontWeight="SemiBold"
                                        FontSize="16" />
                                    <TextBlock
                                        Text="{x:Bind StatusText}"
                                        FontSize="12"
                                        Opacity="0.65" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1">
                                    <TextBlock
                                        Text="Start — koniec"
                                        FontSize="11"
                                        Opacity="0.55" />
                                    <TextBlock
                                        Text="{x:Bind DateRangeText}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2">
                                    <TextBlock
                                        Text="Format"
                                        FontSize="11"
                                        Opacity="0.55" />
                                    <TextBlock
                                        Text="{x:Bind SummaryText}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="3"
                                    HorizontalAlignment="Right">
                                    <TextBlock
                                        Text="Zwycięzca"
                                        FontSize="11"
                                        Opacity="0.55"
                                        HorizontalAlignment="Right" />
                                    <TextBlock
                                        Text="{x:Bind DisplayWinnerName}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <!-- Konfiguracja silników -->
            <Grid
                x:Name="EnginesView"
                Visibility="Collapsed"
                Padding="24"
                RowSpacing="16"
                DataContext="{x:Bind Hub}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock
                            Text="Silniki UCI"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Lokalne procesy — bez połączenia z internetem"
                            Opacity="0.65" />
                    </StackPanel>
                    <ProgressRing
                        IsActive="{Binding IsBusy}"
                        HorizontalAlignment="Right"
                        Width="28"
                        Height="28" />
                </Grid>
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="4*" />
                        <ColumnDefinition
                            Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Wykryte silniki"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <Button
                                Grid.Column="1"
                                Content="Dodaj plik EXE"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="AddEngine_Click" />
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding Engines}"
                            SelectedItem="{Binding SelectedManagedEngine, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate
                                    x:DataType="models:EngineDefinition" xmlns:models="using:ChessDesktopApp.Models">
                                    <StackPanel
                                        Padding="8,5">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="{x:Bind Status}"
                                            FontSize="12" />
                                        <TextBlock
                                            Text="{x:Bind DisplayPath}"
                                            TextTrimming="CharacterEllipsis"
                                            FontSize="11"
                                            Opacity="0.55" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid
                            Grid.Row="2"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Content="Testuj UCI"
                                Click="ValidateEngine_Click"
                                HorizontalAlignment="Stretch" />
                            <Button
                                Grid.Column="1"
                                Content="Usuń z konfiguracji"
                                Click="RemoveEngine_Click"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                    </Grid>
                    <ScrollViewer
                        Grid.Column="1">
                        <StackPanel
                            Spacing="12">
                            <InfoBar
                                IsOpen="{Binding HasError}"
                                Severity="Error"
                                IsClosable="False"
                                Message="{Binding ErrorText}" />
                            <TextBlock
                                Text="Instalacja silników"
                                FontSize="20"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Pobierz silnik z oficjalnej strony projektu, rozpakuj go, a następnie wybierz właściwy plik .exe przyciskiem „Dodaj plik EXE”. Pliki możesz trzymać w dowolnym miejscu lub w przygotowanych katalogach aplikacji:"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding EnginesPath}"
                                FontFamily="Cascadia Mono"
                                TextWrapping="Wrap"
                                Opacity="0.75" />
                            <Border
                                Background="{StaticResource ChessPanelBrush}"
                                BorderBrush="{StaticResource ChessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                RequestedTheme="Dark">
                                <StackPanel
                                    Spacing="7">
                                    <TextBlock
                                        Text="Obsługiwane przez wspólny standard UCI"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Lc0 · Berserk · Obsidian · Caissa · Alexandria · Koivisto · RubiChess · Ethereal Standard · Smallbrain"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="Lc0: umieść plik sieci .pb.gz w katalogu silnika albo skonfiguruj ścieżkę weights zgodnie z wydaniem Lc0. Jeśli sieć nie zostanie znaleziona, test UCI pokaże komunikat diagnostyczny."
                                        TextWrapping="Wrap"
                                        Opacity="0.72" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Text="Dane lokalne"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Konfiguracja silników, PGN-y i turnieje są przechowywane tutaj:" />
                            <TextBlock
                                Text="{Binding StoragePath}"
                                FontFamily="Cascadia Mono"
                                TextWrapping="Wrap"
                                Opacity="0.75" />
                            <TextBlock
                                Text="Usunięcie silnika w aplikacji usuwa tylko wpis konfiguracyjny — plik wykonywalny pozostaje na dysku."
                                TextWrapping="Wrap"
                                Opacity="0.65" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Window>