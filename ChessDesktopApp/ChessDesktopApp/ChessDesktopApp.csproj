<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ChessDesktopApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The same executable is also hosted by the optional MSIX packaging project.
         In a process that already has package identity the dynamic-dependency
         bootstrap must be a no-op instead of terminating with 0x80070032. -->
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chess.Core\Chess.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\BackChevron.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Stockfish\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ENGINE_SETUP.md" Link="ENGINE_SETUP.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Reflection-based JSON repositories require complete model metadata. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <Target Name="CopyWinUiResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_WinUiPublishedResource Include="$(TargetDir)**\*.xbf" />
      <_WinUiPublishedResource Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiPublishedResource)"
          DestinationFiles="@(_WinUiPublishedResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
